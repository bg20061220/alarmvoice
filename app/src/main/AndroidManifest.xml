<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Dangerous permissions: require runtime request on Android 6.0+ -->
    <!-- SCHEDULE_EXACT_ALARM: needed for setExactAndAllowWhileIdle() (Android 12+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- RECORD_AUDIO: needed for SpeechRecognizer -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- WAKE_LOCK: needed for PowerManager.newWakeLock() -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- VIBRATE: optional, for haptic feedback (not used in current version) -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.VoiceSnooze">

        <!-- MainActivity: the home screen where users set alarms -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <!-- MAIN action + LAUNCHER category = app appears in launcher -->
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- AlarmRingActivity: fullscreen alarm UI -->
        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <!-- Note: showWhenLocked and turnScreenOn are Android 8.1+ (API 27+).
                 Older devices fall back to WindowManager flags in the code. -->
        </activity>

        <!-- AlarmReceiver: receives the alarm broadcast from AlarmManager -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.voicesnooze.ALARM_ALERT" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
